---
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
	getLocalizedPath,
	resolvePageContextFromPath,
	type PageId,
} from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { reviewsBasePath } from '../data/reviews';
import { getForumsBasePath } from '../data/forums';
import { getPageImageSrc } from '../data/page-images';
import { siteConfig } from '../data/site';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
}

const { locale = defaultLocale, pageId: pageIdProp } = Astro.props;
const pathContext = resolvePageContextFromPath(Astro.url.pathname);
const pageId = pageIdProp ?? pathContext.pageId ?? 'home';
const current = Astro.url.pathname;
const t = getT(locale);
const homeHref = getLocalizedPath('home', locale);

function isActive(href: string) {
	if (href === '/') return current === '/' || current === `/${locale}/`;
	if (href === reviewsBasePath) return current === href || current.startsWith(href);
	return current === href || current.startsWith(href);
}

const icons: Record<string, string> = {
	home: 'M5.5 11.2 12 6.2l6.5 5M7 11.2V18a1.2 1.2 0 001.2 1.2h7.6A1.2 1.2 0 0017 18v-6.8M10.2 19.2V14h3.6v5.2',
	hacks:
		'M12 3.5l7.5 4.2v8.6L12 20.5l-7.5-4.2V7.7L12 3.5zm0 2.2L6.8 8.5v6.9L12 18.3l5.2-2.9V8.5L12 5.7z',
	esp: 'M12 5a7 7 0 100 14 7 7 0 000-14zm0 2.2a4.8 4.8 0 110 9.6 4.8 4.8 0 010-9.6zM12 10.2v2.4l1.8 1.1',
	pricing:
		'M7.5 7.2h9M7.5 12h9M7.5 16.8H14M5 4.8h14a1.2 1.2 0 011.2 1.2v12a1.2 1.2 0 01-1.2 1.2H5A1.2 1.2 0 013.8 18V6A1.2 1.2 0 015 4.8z',
	updates:
		'M12 4.2v3.2M12 16.6v3.2M4.2 12h3.2M16.6 12h3.2M7.1 7.1l2.3 2.3M14.6 14.6l2.3 2.3M16.9 7.1l-2.3 2.3M9.4 14.6l-2.3 2.3',
	reviews:
		'M12 4.5l1.8 4.9H19l-4.1 3.2 1.6 5L12 14.9 7.5 17.6l1.6-5L5 9.4h5.2L12 4.5z',
	forums:
		'M8 6h8M8 10h8M8 14h5M6 4.8h12a1.2 1.2 0 011.2 1.2v12a1.2 1.2 0 01-1.2 1.2H6A1.2 1.2 0 014.8 18V6A1.2 1.2 0 016 4.8z',
};

const links = [
	{ id: 'home', labelKey: 'nav.home', href: getLocalizedPath('home', locale) },
	{ id: 'hacks', labelKey: 'nav.preview', edit: 'navPreview', href: getLocalizedPath('hacks', locale) },
	{
		id: 'esp',
		labelKey: 'nav.features',
		edit: 'navFeatures',
		href: getLocalizedPath('features', locale),
		bgImage: getPageImageSrc('features'),
	},
	{
		id: 'pricing',
		labelKey: 'nav.store',
		edit: 'navStore',
		href: getLocalizedPath('pricing', locale),
		bgImage: getPageImageSrc('pricing'),
	},
	{
		id: 'updates',
		labelKey: 'nav.status',
		edit: 'navStatus',
		href: getLocalizedPath('updates', locale),
		bgImage: getPageImageSrc('updates'),
	},
	{ id: 'forums', labelKey: 'nav.forums', href: getForumsBasePath(locale) },
	{ id: 'reviews', labelKey: 'nav.reviews', edit: 'navReviews', href: reviewsBasePath },
];

const navLinks = links.map((item) => ({
	...item,
	label: t(item.labelKey),
	active: isActive(item.href),
}));
---

<header class="site-header" data-nav="true">
	<div class="shell site-header__bar">
		<a class="site-brand" href={homeHref} data-edit="name" aria-label={siteConfig.name}>
			<span class="site-brand__mark">Ark</span>
			<span class="site-brand__accent">Cheats</span>
		</a>
		<nav class="site-nav" aria-label={t('nav.primaryAria')}>
			{
				navLinks.map((item) => (
					<a
						href={item.href}
						class:list={[
							'site-nav__link',
							{ 'is-active': item.active, 'has-bg': item.bgImage && item.active },
						]}
					>
						{item.bgImage && item.active ? (
							<span class="site-nav__bg" aria-hidden="true">
								<img
									src={item.bgImage}
									alt=""
									loading="eager"
									decoding="async"
									fetchpriority="high"
								/>
							</span>
						) : null}
						<span class="site-nav__label">
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path
									d={icons[item.id]}
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
							<span data-edit={item.edit}>{item.label}</span>
						</span>
					</a>
				))
			}
		</nav>
		<div class="site-tools">
			<div class="site-tools__lang">
				<LanguageSwitcher currentLocale={locale} pageId={pageId} />
			</div>
			<a
				href={siteConfig.checkoutUrl}
				class="site-tools__buy"
				rel="noopener noreferrer"
				aria-label={t('cta.buyShort')}
			>
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M4.5 6.5h2.1l1.2 9.2h9.4l1.8-6.6H8.1M9.2 19.2a.9.9 0 100-1.8.9.9 0 000 1.8zm7.4 0a.9.9 0 100-1.8.9.9 0 000 1.8z"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
				<span data-edit="ctaBuyShort">{t('cta.buyShort')}</span>
			</a>
			<button
				type="button"
				class="site-menu"
				aria-expanded="false"
				aria-controls="site-nav-panel"
				aria-label={t('nav.openMenu')}
				data-nav-toggle
			>
				<span class="site-menu__bars" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
			</button>
		</div>
	</div>
	<div class="site-panel" id="site-nav-panel" hidden>
		<div class="shell site-panel__inner">
			<nav class="site-panel__nav" aria-label={t('nav.mobileAria')}>
				{
					navLinks.map((item) => (
						<a href={item.href} class:list={[{ 'is-active': item.active }]}>
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path
									d={icons[item.id]}
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
							<span>{item.label}</span>
						</a>
					))
				}
			</nav>
			<div class="site-panel__foot">
				<div class="site-panel__lang">
					<LanguageSwitcher currentLocale={locale} pageId={pageId} />
				</div>
				<a href={siteConfig.checkoutUrl} class="site-panel__buy" rel="noopener noreferrer">
					<span data-edit="ctaBuy">{t('cta.buy')}</span>
				</a>
			</div>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector('[data-nav="true"]');
	const toggle = document.querySelector('[data-nav-toggle]');
	const panel = document.getElementById('site-nav-panel');

	const setOpen = (open: boolean) => {
		if (!header || !toggle || !panel) return;
		header.classList.toggle('is-open', open);
		toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		panel.hidden = !open;
		document.body.classList.toggle('nav-lock', open);
	};

	const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);

	toggle?.addEventListener('click', () => {
		setOpen(!header?.classList.contains('is-open'));
	});

	panel?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setOpen(false));
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setOpen(false);
	});

	window.addEventListener('resize', () => {
		if (window.matchMedia('(min-width: 1025px)').matches) setOpen(false);
	});

	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style is:global>
	body.nav-lock {
		overflow: hidden;
	}

	.site-header .lang-switcher,
	.site-panel .lang-switcher {
		position: relative;
	}

	.site-header .lang-switcher__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 2.15rem;
		padding: 0 0.75rem;
		border: 1px solid var(--line-soft);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 70%, transparent);
		color: var(--ink-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		list-style: none;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.site-header .lang-switcher__toggle::-webkit-details-marker {
		display: none;
	}

	.site-header .lang-switcher__toggle:hover {
