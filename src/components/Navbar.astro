---
import NavbarApp from './react/Navbar';
import {
	getLocalizedPath,
	getPageLocaleSwitchHref,
	resolvePageContextFromPath,
	type PageId,
} from '../data/i18n/routing';
import { defaultLocale, locales, type LocaleCode } from '../data/i18n/locales';
import { reviewsBasePath } from '../data/reviews';
import { getForumsBasePath } from '../data/forums';
import { getPageImageSrc } from '../data/page-images';
import { siteConfig } from '../data/site';
import { getBlogLocaleSwitchHref, isBlogPath } from '../data/blog/helpers';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
}

const { locale = defaultLocale, pageId: pageIdProp } = Astro.props;
const pathContext = resolvePageContextFromPath(Astro.url.pathname);
const pageId = pageIdProp ?? pathContext.pageId ?? 'home';
const current = Astro.url.pathname;
const onBlog = isBlogPath(current);

const pageContext = onBlog
	? pathContext
	: {
			...pathContext,
			pageId: pathContext.pageId ?? pageId,
		};

function localeSwitchHref(targetLocale: LocaleCode): string {
	if (onBlog) return getBlogLocaleSwitchHref(current, targetLocale);
	return getPageLocaleSwitchHref(pageContext, targetLocale);
}

const hrefForLocale = Object.fromEntries(
	locales.map((l) => [l.code, localeSwitchHref(l.code)]),
) as Record<string, string>;

const localeMetas = locales.map((l) => ({
	code: l.code,
	name: l.name,
	nativeName: l.nativeName,
	hreflang: l.hreflang,
	region: l.region,
}));

const links = [
	{ id: 'home', labelKey: 'nav.home', href: getLocalizedPath('home', locale) },
	{ id: 'hacks', labelKey: 'nav.preview', edit: 'navPreview', href: getLocalizedPath('hacks', locale) },
	{
		id: 'esp',
		labelKey: 'nav.features',
		edit: 'navFeatures',
		href: getLocalizedPath('features', locale),
		bgImage: getPageImageSrc('features'),
	},
	{
		id: 'pricing',
		labelKey: 'nav.store',
		edit: 'navStore',
		href: getLocalizedPath('pricing', locale),
		bgImage: getPageImageSrc('pricing'),
	},
	{
		id: 'updates',
		labelKey: 'nav.status',
		edit: 'navStatus',
		href: getLocalizedPath('updates', locale),
		bgImage: getPageImageSrc('updates'),
	},
	{ id: 'forums', labelKey: 'nav.forums', href: getForumsBasePath(locale) },
	{ id: 'reviews', labelKey: 'nav.reviews', edit: 'navReviews', href: reviewsBasePath },
];
---

<NavbarApp
	client:load
	locale={locale}
	siteName={siteConfig.name}
	checkoutUrl={siteConfig.checkoutUrl}
	currentPath={current}
	homeHref={getLocalizedPath('home', locale)}
	reviewsBasePath={reviewsBasePath}
	locales={localeMetas}
	hrefForLocale={hrefForLocale}
	links={links}
/>

<style is:global>
	body.nav-lock {
		overflow: hidden;
	}

	.site-header .lang-switcher,
	.site-panel .lang-switcher {
		position: relative;
	}

	.site-header .lang-switcher__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 2.15rem;
		padding: 0 0.75rem;
		border: 1px solid var(--line-soft);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 70%, transparent);
		color: var(--ink-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		list-style: none;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.site-header .lang-switcher__toggle::-webkit-details-marker {
		display: none;
	}

	.site-header .lang-switcher__toggle:hover {
		color: var(--ink);
		border-color: var(--line);
		background: var(--bg-elevated);
	}

	.site-header .lang-switcher__toggle svg {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
	}

	.site-header .lang-switcher__panel {
		position: absolute;
		right: 0;
		left: auto;
		top: calc(100% + 0.45rem);
		min-width: 15rem;
		max-height: min(70vh, 22rem);
		overflow: auto;
		padding: 0.5rem;
		background: var(--bg-elevated);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
		z-index: 120;
	}

	.site-header .lang-switcher__note {
		margin: 0 0 0.5rem;
		padding: 0.45rem 0.55rem;
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--bg-hover) 80%, transparent);
		color: var(--ink-muted);
		font-size: 0.72rem;
		line-height: 1.4;
	}

	.site-header .lang-switcher__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.25rem;
	}

	.site-header .lang-switcher__link {
		display: grid;
		gap: 0.1rem;
		padding: 0.55rem 0.65rem;
		border-radius: var(--radius-sm);
		color: var(--ink);
		text-decoration: none;
		transition: background 0.15s ease;
	}

	.site-header .lang-switcher__native {
		font-size: 0.86rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.site-header .lang-switcher__region {
		font-size: 0.68rem;
		color: var(--ink-faint);
		line-height: 1.2;
	}

	.site-header .lang-switcher__link:hover,
	.site-header .lang-switcher__link.is-current {
		background: color-mix(in srgb, var(--magenta) 12%, transparent);
	}

	.site-panel .lang-switcher__note {
		margin: 0 0 0.5rem;
		padding: 0.45rem 0.55rem;
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--bg-hover) 80%, transparent);
		color: var(--ink-muted);
		font-size: 0.72rem;
		line-height: 1.4;
	}

	.site-panel .lang-switcher__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.25rem;
	}

	.site-panel .lang-switcher__link {
		display: grid;
		gap: 0.1rem;
		padding: 0.55rem 0.65rem;
		border-radius: var(--radius-sm);
		color: var(--ink);
		text-decoration: none;
		transition: background 0.15s ease;
	}

	.site-panel .lang-switcher__native {
		font-size: 0.86rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.site-panel .lang-switcher__region {
		font-size: 0.68rem;
		color: var(--ink-faint);
		line-height: 1.2;
	}

	.site-panel .lang-switcher__link:hover,
	.site-panel .lang-switcher__link.is-current {
		background: color-mix(in srgb, var(--magenta) 12%, transparent);
	}

	.site-panel .lang-switcher {
		width: 100%;
	}

	.site-panel .lang-switcher__toggle {
		width: 100%;
		justify-content: flex-start;
		height: 2.75rem;
		border-radius: var(--radius-sm);
	}

	.site-panel .lang-switcher__panel {
		position: static;
		margin-top: 0.45rem;
		max-height: 12rem;
		box-shadow: none;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding-top: var(--safe-top, env(safe-area-inset-top, 0px));
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid transparent;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.site-header.is-scrolled,
	.site-header.is-open {
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		border-bottom-color: var(--line-soft);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
	}

	.site-header__bar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: var(--header-h);
		gap: 0.75rem;
	}

	@media (min-width: 1025px) {
		.site-header__bar {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
		}
	}

	.site-brand {
		display: inline-flex;
		align-items: baseline;
		min-width: 0;
		flex: 0 1 auto;
		margin-right: 0.35rem;
		font-family: var(--font-display);
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		transition: opacity 0.15s ease;
	}

	.site-brand__mark {
		color: var(--ink);
	}

	.site-brand__accent {
		color: var(--magenta-soft);
	}

	.site-brand:hover .site-brand__mark {
		color: var(--ink);
	}

	.site-brand:hover .site-brand__accent {
		color: color-mix(in srgb, var(--magenta-soft) 82%, #fff);
	}

	@media (min-width: 1025px) {
		.site-brand {
			grid-column: 1;
			justify-self: start;
			margin-right: 0;
			font-size: 0.8rem;
		}
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.18rem 0.28rem;
		border: 1px solid color-mix(in srgb, var(--line-soft) 85%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 52%, transparent);
		box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 4%, transparent);
	}

	@media (min-width: 1025px) {
		.site-nav {
			grid-column: 2;
			justify-self: center;
		}
	}

	.site-nav__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		overflow: hidden;
		gap: 0.28rem;
		padding: 0.3rem 0.62rem;
		border-radius: 999px;
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		color: var(--ink-muted);
		white-space: nowrap;
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.site-nav__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		border-radius: inherit;
		overflow: hidden;
		pointer-events: none;
	}

	.site-nav__bg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		filter: blur(5px);
		transform: scale(1.2);
		opacity: 0.42;
	}

	.site-nav__bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--bg-elevated) 72%, transparent);
	}

	.site-nav__link.has-bg.is-active .site-nav__bg::after {
		background: color-mix(in srgb, var(--bg) 55%, transparent);
	}

	.site-nav__label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
	}

	.site-nav a,
	.site-nav__link {
		text-decoration: none;
	}

	.site-nav__link svg {
		width: 0.76rem;
		height: 0.76rem;
		flex-shrink: 0;
		opacity: 0.65;
	}

	.site-nav__link:hover {
		color: var(--ink);
		background: color-mix(in srgb, #fff 5%, transparent);
	}

	.site-nav__link.has-bg:hover {
		background: transparent;
	}

	.site-nav__link:hover svg,
	.site-nav__link.is-active svg {
		opacity: 1;
		color: var(--magenta-soft);
	}

	.site-nav__link.is-active {
		color: var(--ink);
		background: color-mix(in srgb, #fff 8%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #fff 5%, transparent);
	}

	.site-nav__link.has-bg.is-active {
		background: transparent;
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #fff 10%, transparent);
	}

	.site-tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.45rem;
		margin-left: auto;
		min-width: 0;
	}

	@media (min-width: 1025px) {
		.site-tools {
			grid-column: 3;
			justify-self: end;
			margin-left: 0;
		}
	}

	.site-tools__buy {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.15rem;
		height: auto;
		padding: 0 1rem;
		border-radius: 999px;
		background: #fff;
		color: #09090b;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}

	.site-tools__buy svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	.site-tools__buy:hover {
		background: #ececef;
		color: #09090b;
		transform: translateY(-1px);
	}

	.site-menu {
		display: none;
		align-items: center;
		justify-content: center;
		width: var(--touch-min, 2.75rem);
		height: var(--touch-min, 2.75rem);
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 75%, transparent);
		color: var(--ink);
		flex-shrink: 0;
	}

	.site-menu__bars {
		display: grid;
		gap: 3.5px;
		width: 0.95rem;
	}

	.site-menu__bars span {
		display: block;
		height: 1.5px;
		border-radius: 999px;
		background: currentColor;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
		transform-origin: center;
	}

	.site-header.is-open .site-menu__bars span:nth-child(1) {
		transform: translateY(5px) rotate(45deg);
	}

	.site-header.is-open .site-menu__bars span:nth-child(2) {
		opacity: 0;
	}

	.site-header.is-open .site-menu__bars span:nth-child(3) {
		transform: translateY(-5px) rotate(-45deg);
	}

	.site-panel {
		border-top: 1px solid var(--line-soft);
		background: var(--bg);
		padding: 0.35rem 0 max(1.35rem, env(safe-area-inset-bottom, 0px));
		max-height: min(70dvh, calc(100dvh - var(--header-h)));
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior: contain;
		animation: panel-in 0.18s ease-out;
	}

	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.site-panel__nav {
		display: grid;
	}

	.site-panel__nav a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: var(--touch-min, 2.75rem);
		padding: 0.85rem 0.15rem;
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: -0.015em;
		color: var(--ink-muted);
		border-bottom: 1px solid var(--line-soft);
	}

	.site-panel__nav a svg {
		width: 1.1rem;
		height: 1.1rem;
		color: var(--magenta-soft);
		opacity: 0.9;
	}

	.site-panel__nav a:hover,
	.site-panel__nav a.is-active {
		color: var(--ink);
	}

	.site-panel__nav a.is-active {
		color: var(--magenta-soft);
	}

	.site-panel__foot {
		display: grid;
		gap: 0.75rem;
		margin-top: 1.1rem;
	}

	.site-panel__buy {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.85rem;
		border-radius: 999px;
		background: #fff;
		color: #09090b;
		font-weight: 600;
	}

	.site-panel__buy:hover {
		background: #e4e4e7;
		color: #09090b;
	}

	@media (max-width: 1024px) {
		.site-nav,
		.site-tools__lang {
			display: none;
		}

		.site-brand {
			flex: 1 1 auto;
			min-width: 0;
			max-width: none;
			font-size: 0.88rem;
		}

		.site-header__bar {
			justify-content: space-between;
			gap: 0.55rem;
		}

		.site-tools__buy {
			min-height: var(--touch-min, 2.75rem);
			padding-inline: 0.85rem;
			font-size: 0.8rem;
			flex-shrink: 0;
		}

		.site-menu {
			display: inline-flex;
		}

		.site-header.is-open {
			background: var(--bg);
		}

		.site-panel {
			max-height: calc(100dvh - var(--header-h) - var(--safe-top, 0px) - var(--safe-bottom, 0px));
		}
	}

	@media (max-width: 480px) {
		.site-brand {
			font-size: 0.84rem;
		}

		.site-tools {
			gap: 0.4rem;
		}

		.site-tools__buy {
			padding-inline: 0.7rem;
		}
	}

	@media (max-width: 360px) {
		.site-tools__buy span {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.site-tools__buy {
			padding-inline: 0.7rem;
			min-width: var(--touch-min);
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-nav a,
		.site-tools__buy,
		.site-menu__bars span,
		.site-panel {
			transition: none;
			animation: none;
		}

		.site-tools__buy:hover {
			transform: none;
		}
	}
</style>
