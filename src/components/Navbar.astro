		height: 0.76rem;
		flex-shrink: 0;
		opacity: 0.65;
	}

	.site-nav__link:hover {
		color: var(--ink);
		background: color-mix(in srgb, #fff 5%, transparent);
	}

	.site-nav__link.has-bg:hover {
