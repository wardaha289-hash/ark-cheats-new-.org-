	}

	.site-nav__link:hover svg,
	.site-nav__link.is-active svg {
		opacity: 1;
		color: var(--magenta-soft);
	}

	.site-nav__link.is-active {
		color: var(--ink);
		background: color-mix(in srgb, #fff 8%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #fff 5%, transparent);
	}

	.site-nav__link.has-bg.is-active {
		background: transparent;
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #fff 10%, transparent);
	}

	.site-tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.45rem;
		margin-left: auto;
		min-width: 0;
	}

