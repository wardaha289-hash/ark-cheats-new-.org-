		text-decoration: none;
		transition: background 0.15s ease;
	}

	.site-header .lang-switcher__native {
		font-size: 0.86rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.site-header .lang-switcher__region {
		font-size: 0.68rem;
		color: var(--ink-faint);
		line-height: 1.2;
	}

	.site-header .lang-switcher__link:hover,
	.site-header .lang-switcher__link.is-current {
		background: color-mix(in srgb, var(--magenta) 12%, transparent);
	}

	.site-panel .lang-switcher__note {
		margin: 0 0 0.5rem;
		padding: 0.45rem 0.55rem;
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--bg-hover) 80%, transparent);
		color: var(--ink-muted);
		font-size: 0.72rem;
		line-height: 1.4;
	}

	.site-panel .lang-switcher__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.25rem;
	}

	.site-panel .lang-switcher__link {
		display: grid;
		gap: 0.1rem;
		padding: 0.55rem 0.65rem;
		border-radius: var(--radius-sm);
		color: var(--ink);
		text-decoration: none;
		transition: background 0.15s ease;
	}

	.site-panel .lang-switcher__native {
		font-size: 0.86rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.site-panel .lang-switcher__region {
		font-size: 0.68rem;
		color: var(--ink-faint);
		line-height: 1.2;
	}

	.site-panel .lang-switcher__link:hover,
	.site-panel .lang-switcher__link.is-current {
		background: color-mix(in srgb, var(--magenta) 12%, transparent);
	}

	.site-panel .lang-switcher {
		width: 100%;
	}

	.site-panel .lang-switcher__toggle {
		width: 100%;
		justify-content: flex-start;
		height: 2.75rem;
		border-radius: var(--radius-sm);
	}

	.site-panel .lang-switcher__panel {
		position: static;
		margin-top: 0.45rem;
		max-height: 12rem;
		box-shadow: none;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding-top: var(--safe-top, env(safe-area-inset-top, 0px));
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid transparent;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.site-header.is-scrolled,
	.site-header.is-open {
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		border-bottom-color: var(--line-soft);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
	}

	.site-header__bar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: var(--header-h);
		gap: 0.75rem;
	}

	@media (min-width: 1025px) {
		.site-header__bar {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
		}
	}

	.site-brand {
		display: inline-flex;
		align-items: baseline;
		min-width: 0;
		flex: 0 1 auto;
		margin-right: 0.35rem;
		font-family: var(--font-display);
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		transition: opacity 0.15s ease;
	}

	.site-brand__mark {
		color: var(--ink);
	}

	.site-brand__accent {
		color: var(--magenta-soft);
	}

	.site-brand:hover .site-brand__mark {
		color: var(--ink);
	}

	.site-brand:hover .site-brand__accent {
		color: color-mix(in srgb, var(--magenta-soft) 82%, #fff);
	}

	@media (min-width: 1025px) {
		.site-brand {
			grid-column: 1;
			justify-self: start;
			margin-right: 0;
			font-size: 0.8rem;
		}
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.18rem 0.28rem;
		border: 1px solid color-mix(in srgb, var(--line-soft) 85%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 52%, transparent);
		box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 4%, transparent);
	}

	@media (min-width: 1025px) {
		.site-nav {
			grid-column: 2;
			justify-self: center;
		}
	}

	.site-nav__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		overflow: hidden;
		gap: 0.28rem;
		padding: 0.3rem 0.62rem;
		border-radius: 999px;
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		color: var(--ink-muted);
		white-space: nowrap;
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.site-nav__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		border-radius: inherit;
		overflow: hidden;
		pointer-events: none;
	}

	.site-nav__bg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		filter: blur(5px);
		transform: scale(1.2);
		opacity: 0.42;
	}

	.site-nav__bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--bg-elevated) 72%, transparent);
	}

	.site-nav__link.has-bg.is-active .site-nav__bg::after {
		background: color-mix(in srgb, var(--bg) 55%, transparent);
