		background: var(--bg-elevated);
	}

	.site-header .lang-switcher__toggle svg {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
	}

	.site-header .lang-switcher__panel {
		position: absolute;
		right: 0;
		left: auto;
		top: calc(100% + 0.45rem);
		min-width: 15rem;
		max-height: min(70vh, 22rem);
		overflow: auto;
		padding: 0.5rem;
		background: var(--bg-elevated);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
		z-index: 120;
	}

	.site-header .lang-switcher__note {
		margin: 0 0 0.5rem;
		padding: 0.45rem 0.55rem;
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--bg-hover) 80%, transparent);
		color: var(--ink-muted);
		font-size: 0.72rem;
		line-height: 1.4;
	}

	.site-header .lang-switcher__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.25rem;
	}

	.site-header .lang-switcher__link {
		display: grid;
		gap: 0.1rem;
		padding: 0.55rem 0.65rem;
		border-radius: var(--radius-sm);
