---
import { getLocalizedPath, type PageId } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getForumsBasePath } from '../data/forums';
import { reviewsBasePath } from '../data/reviews';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const previewSrc = '/images/ark-cheats-wallhack-480w.webp';

type CatLink = { href: string; labelKey: string };

function link(pageId: PageId, labelKey: string): CatLink {
	return { href: getLocalizedPath(pageId, locale), labelKey };
}
type Category = {
	id: string;
	titleKey: string;
	hintKey: string;
	tone: string;
	links: CatLink[];
};

const categories: Category[] = [
	{
		id: 'features',
		titleKey: 'homeSeo.catFeatures',
		hintKey: 'homeSeo.catFeaturesHint',
		tone: 'violet',
		links: [
			link('features', 'homeSeo.linkAllFeatures'),
			link('ark-esp', 'homeSeo.linkEsp'),
			link('ark-aimbot', 'homeSeo.linkAimbot'),
			link('radar', 'homeSeo.linkRadar'),
		],
	},
	{
		id: 'status',
		titleKey: 'homeSeo.catStatus',
		hintKey: 'homeSeo.catStatusHint',
		tone: 'violet',
		links: [
			link('updates', 'homeSeo.linkLiveStatus'),
			link('hacks', 'homeSeo.linkUndetected'),
			link('setup', 'homeSeo.linkSetup'),
			link('faq', 'homeSeo.linkFaq'),
		],
	},
	{
		id: 'store',
		titleKey: 'homeSeo.catStore',
		hintKey: 'homeSeo.catStoreHint',
		tone: 'violet',
		links: [
			link('pricing', 'nav.buyNow'),
			link('pricing', 'homeSeo.linkPlans'),
			{ href: reviewsBasePath, labelKey: 'homeSeo.linkReviews' },
			link('hacks', 'nav.preview'),
		],
	},
	{
		id: 'help',
		titleKey: 'homeSeo.catHelp',
		hintKey: 'homeSeo.catHelpHint',
		tone: 'violet',
		links: [
			link('support', 'homeSeo.linkSupport'),
			link('setup', 'homeSeo.linkSetupGuide'),
			{ href: getForumsBasePath(locale), labelKey: 'homeSeo.linkForums' },
			link('faq', 'homeSeo.linkFaq'),
		],
	},
];
---

<section class="home-about shell" aria-labelledby="home-about-title">
	<div class="home-about__hero">
		<div class="home-about__copy">
			<p class="home-about__eyebrow">{t('homeSeo.eyebrow')}</p>
			<h2 id="home-about-title">{t('homeSeo.title')}</h2>
			<p class="home-about__lede">{t('home.aboutLede')}</p>
			<p class="home-about__links">
				{t('home.aboutP2Before')}{' '}
				<a href={getLocalizedPath('hacks', locale)}>{t('home.aboutPillar')}</a>{t('home.aboutP2Mid')}
				<a href={getLocalizedPath('ark-esp', locale)}>{t('home.aboutEsp')}</a>{t('home.aboutP2Mid')}
				<a href={getLocalizedPath('ark-aimbot', locale)}>{t('home.aboutAimbot')}</a>{t('home.aboutP2Or')}
				<a href={getLocalizedPath('updates', locale)}>{t('home.aboutUndetected')}</a>
				{t('home.aboutP2After')}
			</p>
		</div>
		<figure class="home-about__media">
			<img
				src={previewSrc}
				alt={t('images.espWallhack')}
				width="480"
				height="300"
				loading="lazy"
				decoding="async"
			/>
			<figcaption class="home-about__tag">{t('nav.preview')}</figcaption>
		</figure>
	</div>

	<div class="home-about__cats">
		{
			categories.map((cat) => (
				<nav class={`home-about__cat home-about__cat--${cat.tone}`} aria-label={t(cat.titleKey)}>
					<header class="home-about__cat-head">
						<h3>{t(cat.titleKey)}</h3>
						<p>{t(cat.hintKey)}</p>
					</header>
					<ul>
						{cat.links.map((link) => (
							<li>
								<a href={link.href}>
									<span>{t(link.labelKey)}</span>
									<span class="home-about__cat-arrow" aria-hidden="true" />
								</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>
</section>

<style>
	.home-about {
		padding-block: clamp(2rem, 4vw, 2.75rem);
		border-bottom: 1px solid var(--line-soft);
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.home-about__hero {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(1rem, 2.5vw, 1.5rem);
		align-items: stretch;
		margin-bottom: 1.35rem;
		padding-bottom: 1.35rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-about__copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.55rem;
		min-width: 0;
		padding-left: 0.85rem;
		border-left: 2px solid var(--magenta-soft);
	}

	.home-about__eyebrow {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home-about__copy h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3.5vw, 2.35rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.08;
		color: var(--ink);
	}

	.home-about__lede {
		margin: 0;
		max-width: 34rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	.home-about__links {
		margin: 0.1rem 0 0;
		max-width: 34rem;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.home-about__links a {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home-about__links a:hover {
		color: var(--ink);
	}

	.home-about__media {
		position: relative;
		margin: 0;
		min-height: clamp(10rem, 22vw, 14rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		overflow: hidden;
		background: var(--bg-panel);
	}

	.home-about__media img {
		display: block;
		width: 100%;
		height: 100%;
		min-height: inherit;
		object-fit: cover;
		object-position: center;
	}

	.home-about__tag {
		position: absolute;
		left: 0.7rem;
		bottom: 0.7rem;
		margin: 0;
		padding: 0.28rem 0.6rem;
		border-radius: 999px;
		background: rgba(8, 9, 10, 0.78);
		border: 1px solid color-mix(in srgb, #fff 12%, transparent);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.home-about__cats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.65rem;
		align-items: stretch;
	}

	.home-about__cat {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		overflow: hidden;
		transition: border-color 0.2s ease;
	}

	.home-about__cat:hover {
		border-color: color-mix(in srgb, var(--magenta) 28%, var(--line));
	}

	.home-about__cat-head {
		padding: 0.95rem 1rem 0.8rem;
		border-bottom: 1px solid var(--line-soft);
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--cat-tone) 16%, var(--bg-elevated)) 0%,
			var(--bg-elevated) 100%
		);
	}

	.home-about__cat--violet {
		--cat-tone: var(--magenta-soft);
	}

	.home-about__cat--green {
		--cat-tone: var(--ok);
	}

	.home-about__cat--blue {
		--cat-tone: #5bb5ff;
	}

	.home-about__cat--amber {
		--cat-tone: #f59e0b;
	}

	.home-about__cat-head h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2vw, 1.65rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1;
		color: var(--cat-tone);
	}

	.home-about__cat-head p {
		margin: 0.3rem 0 0;
		font-size: 0.75rem;
		line-height: 1.35;
		color: var(--ink-faint);
	}

	.home-about__cat ul {
		margin: 0;
		padding: 0.25rem 0;
		list-style: none;
		display: grid;
		flex: 1;
	}

	.home-about__cat a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		min-height: var(--touch-min, 2.75rem);
		padding: 0.7rem 1rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-muted);
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.home-about__cat-arrow {
		width: 0.35rem;
		height: 0.35rem;
		flex-shrink: 0;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(-45deg);
		opacity: 0;
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.home-about__cat a:hover {
		background: color-mix(in srgb, var(--magenta) 8%, transparent);
		color: var(--magenta-soft);
	}

	.home-about__cat a:hover .home-about__cat-arrow {
		opacity: 0.9;
		transform: rotate(-45deg) translate(1px, 1px);
	}

	@media (max-width: 900px) {
		.home-about__hero {
			grid-template-columns: 1fr;
		}

		.home-about__cats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.home-about__cats {
			grid-template-columns: 1fr;
		}

		.home-about__copy {
			padding-left: 0.65rem;
		}
	}
</style>
