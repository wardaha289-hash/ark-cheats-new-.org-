---
import ForumThreadPage from '../../../components/ForumThreadPage.astro';
import { forumThreads, getForumThread } from '../../../data/forums';
import { defaultLocale } from '../../../data/i18n/locales';

export function getStaticPaths() {
	return forumThreads.map((thread) => ({
		params: { slug: thread.slug },
		props: { thread },
	}));
}

const { thread } = Astro.props;
const live = getForumThread(thread.slug, defaultLocale) ?? thread;
---

<ForumThreadPage locale={defaultLocale} thread={live} />
